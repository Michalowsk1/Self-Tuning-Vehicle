  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Acceleration adjuster: Responsible how \ndrastically the vehicle speeds
    up\n\nSpeed Up Increment: influences vehicles accleration/speed up per frame
    by an increment that's added to it's speed\n\nMinimum Steering Power: Controls
    sharp the vehicle is able to turn\n\nSteering Enhancer: As name suggests enhances
    the steering power of the vehicle similarily to speed up increment\n\nSide, Angled
    and Straight Detect Distance: controlls how far a ray checks for the edge of
    the race track in that direction, the longer the ray the faster the speed for
    straight and the sharper the turns for angled\n\nOne Last Note: If the car decides
    it wants to stop turning reset the Side Detect Distance to 3, it fixes it, why?
    I have no idea.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
